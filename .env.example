# ============================================================
# GLL Super Admin Configuration
# ============================================================
# Copiar este archivo a .env.local y completar los valores

# ============================================================
# NextAuth Configuration (REQUERIDO para producción)
# ============================================================
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Credenciales de Super Admin
# Email: admin@gll.terminal
# Password: gll_super_admin_2026 (cambiar en producción)
# El hash está en: src/lib/auth/config.ts

# ============================================================
# Supabase Configuration (Producción)
# ============================================================
# Opciones: Vercel Marketplace o configuración manual
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Alternativa: PostgreSQL directo
# ============================================================
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# ============================================================
# GROQ API Key (si usas headless CMS)
# ============================================================
GROQ_API_KEY=your-groq-api-key

# ============================================================
# Entorno de desarrollo local
# ============================================================
# Si no están configurados, se usa JSON local (data/members.json)